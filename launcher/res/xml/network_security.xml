<?xml version="1.0" encoding="utf-8"?>
<!-- No unencrypted HTTP anywhere in the app, and only the system's built-in certificate
     authorities are trusted (user-installed CAs can't be used to intercept the weather requests). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
